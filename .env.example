# Local/dev copy of the Cloudflare Pages env for slop-detect-web.
# NEVER put real values here — copy to apps/web/.dev.vars (gitignored) for
# `wrangler pages dev`, and set production values as Pages env vars / secrets.
# Authoritative list; every key below is read as env.KEY in apps/web/functions.
# KV/browser bindings (RATE_LIMIT, RESULTS, BROWSER) come from wrangler.toml, not env.

# Monitoring pipeline (all required for CF-04 watch/monitor)
CRON_SECRET=
INTERNAL_API_KEY=
SESSION_SECRET=
RESEND_API_KEY=
ALERT_FROM=

# Cost & safety (all optional; defaults in parentheses)
SCAN_DAILY_CAP=10000
SCAN_DISABLED=
ERROR_WEBHOOK=
SWEEP_MAX=50

# Captcha (sitekey is public in wrangler.toml; secret stays server-side)
TURNSTILE_SECRET=

{
  "name": "slop-detect-monorepo",
  "private": true,
  "version": "0.7.0",
  "description": "Score any landing page against the multi-axis (design + copy) AI-slop fingerprint. Detect Cursor/v0/Lovable templates and GPT-default copy in the wild.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://slop-detect.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravidsrk/slop-detect.git"
  },
  "bugs": {
    "url": "https://github.com/ravidsrk/slop-detect/issues"
  },
  "author": "Ravindra Kumar <ravidsrk@gmail.com>",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/web",
    "packages/mcp"
  ],
  "scripts": {
    "scan": "npm run --workspace slop-detect scan --",
    "demo": "npm run --workspace slop-detect demo",
    "web:dev": "npm run --workspace slop-detect-web dev",
    "web:deploy": "npm run --workspace slop-detect-web deploy",
    "calibrate": "node packages/cli/calibration/run.mjs",
    "test": "node --test packages/core/test/*.test.js packages/web/test/*.test.js packages/cli/test/*.test.js packages/mcp/test/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.8.4"
  }
}

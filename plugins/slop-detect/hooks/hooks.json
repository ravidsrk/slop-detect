{
  "description": "After UI edits and before Claude stops, scan the local dev server named by SLOP_LOCAL_URL or .slop/local-url and report only new findings. Does nothing until one of them is set.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.mjs\"",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}

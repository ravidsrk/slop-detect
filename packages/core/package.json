{
  "name": "@slop-detect/core",
  "version": "0.8.0",
  "description": "Pure detection engine for AI-design-slop patterns. Runtime-agnostic — runs in Node, Cloudflare Workers, or the browser.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://slop-detect.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravidsrk/slop-detect.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./patterns": {
      "types": "./dist/patterns.d.ts",
      "import": "./dist/patterns.js",
      "require": "./dist/patterns.cjs"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js",
      "require": "./dist/fonts.cjs"
    },
    "./color": {
      "types": "./dist/color.d.ts",
      "import": "./dist/color.js",
      "require": "./dist/color.cjs"
    },
    "./system": {
      "types": "./dist/system.d.ts",
      "import": "./dist/system.js",
      "require": "./dist/system.cjs"
    },
    "./aeo": {
      "types": "./dist/aeo.d.ts",
      "import": "./dist/aeo.js",
      "require": "./dist/aeo.cjs"
    },
    "./fixes": {
      "types": "./dist/fixes.d.ts",
      "import": "./dist/fixes.js",
      "require": "./dist/fixes.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint ."
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "slop",
    "ai-detection",
    "landing-page",
    "design-audit",
    "tailwind",
    "v0",
    "cursor",
    "lovable",
    "design-quality"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}

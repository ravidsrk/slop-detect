{
  "name": "slop-detect",
  "version": "0.7.0",
  "description": "Score any landing page against the AI-design-slop fingerprint from your terminal. Playwright-based, deterministic, zero-config.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://slop-detect.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravidsrk/slop-detect.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ravidsrk/slop-detect/issues"
  },
  "bin": {
    "slop": "./dist/bin/slop.js",
    "slop-detect": "./dist/bin/slop.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc",
    "scan": "node dist/bin/slop.js",
    "demo": "node dist/bin/slop.js https://news.ycombinator.com https://www.aura.build https://lovable.dev"
  },
  "dependencies": {
    "slop-detect-core": "0.7.0",
    "playwright": "^1.49.0"
  },
  "keywords": [
    "slop",
    "ai-detection",
    "landing-page",
    "design-audit",
    "cli",
    "playwright"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}

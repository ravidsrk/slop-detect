{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    // detector.ts stringifies page-side helpers, so DOM globals appear in scope.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Incremental migration baseline (see MIGRATION.md); ramps to strict per-module.
    "strict": false
  },
  "include": ["bin/**/*.ts", "src/**/*.ts"]
}

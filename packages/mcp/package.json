{
  "name": "slop-detect-mcp",
  "version": "0.8.0",
  "description": "MCP server that lets AI coding agents (Cursor, Claude Code, Windsurf) scan landing pages for AI-design-slop and pull a fix prompt.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://slop-detect.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravidsrk/slop-detect.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/ravidsrk/slop-detect/issues"
  },
  "author": "Ravindra Kumar <ravidsrk@gmail.com>",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "slop-detect-mcp": "./dist/bin/server.js"
  },
  "files": [
    "dist",
    "hooks",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "mkdir -p schema && cp ../../schemas/scan-result.v1.json schema/scan-result.v1.json && tsup",
    "prepack": "node -e 'const fs=require(\"fs\"),p=\"package.json\",j=JSON.parse(fs.readFileSync(p,\"utf8\"));if(j.dependencies&&j.dependencies[\"@slop-detect/core\"]){j.dependencies[\"slop-detect-core\"]=j.version;delete j.dependencies[\"@slop-detect/core\"];}fs.writeFileSync(p,JSON.stringify(j,null,2)+\"\\n\")'",
    "postpack": "node -e 'const fs=require(\"fs\"),p=\"package.json\",j=JSON.parse(fs.readFileSync(p,\"utf8\"));if(j.dependencies&&j.dependencies[\"slop-detect-core\"]){delete j.dependencies[\"slop-detect-core\"];j.dependencies[\"@slop-detect/core\"]=\"workspace:*\";}fs.writeFileSync(p,JSON.stringify(j,null,2)+\"\\n\")'",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slop-detect/core": "workspace:*"
  },
  "devDependencies": {
    "slop-detect": "workspace:*"
  },
  "peerDependencies": {
    "slop-detect": "^0.8.0"
  },
  "peerDependenciesMeta": {
    "slop-detect": {
      "optional": true
    }
  },
  "keywords": [
    "slop",
    "ai-detection",
    "landing-page",
    "design-audit",
    "mcp",
    "model-context-protocol",
    "cursor",
    "claude-code",
    "windsurf"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}

{
  "name": "slop-detect-mcp",
  "version": "0.8.0",
  "description": "MCP server that lets AI coding agents (Cursor, Claude Code, Windsurf) scan landing pages for AI-design-slop and pull a fix prompt.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://slop-detect.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravidsrk/slop-detect.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/ravidsrk/slop-detect/issues"
  },
  "author": "Ravindra Kumar <ravidsrk@gmail.com>",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "slop-detect-mcp": "./dist/bin/server.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "prepack": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "keywords": [
    "slop",
    "ai-detection",
    "landing-page",
    "design-audit",
    "mcp",
    "model-context-protocol",
    "cursor",
    "claude-code",
    "windsurf"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}